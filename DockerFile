# Use an official base image with Chromium
FROM zenika/alpine-chrome:latest

# Set environment variables for Chromium
ENV CHROME_BIN="/usr/bin/chromium-browser" \
    DISPLAY=":0"

# Install required dependencies for running Chromium
RUN apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    libx11 \
    libxcomposite \
    libxdamage \
    libxrandr \
    libxi \
    libxtst \
    nss \
    freetype \
    fontconfig \
    ttf-freefont \
    && apk add --no-cache --virtual .build-deps \
    # Ensure proper installation of Chromium
    chromium

# Set the working directory
WORKDIR /app

# Install Capfizz extension (download and unzip)
RUN curl -L -o capfizz-extension.zip "https://chrome.google.com/webstore/detail/capfizz-sentry-node/agollninopbkafedoijcnbdopajjjmfa" \
    && unzip capfizz-extension.zip -d /app/extension

# Expose the necessary port
EXPOSE 20320

# Start Chromium with the extension loaded (in headless mode)
CMD ["chromium-browser", "--no-sandbox", "--headless", "--disable-gpu", "--remote-debugging-port=9222", "--load-extension=/app/extension"]
