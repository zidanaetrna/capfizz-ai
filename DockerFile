FROM ubuntu:20.04

# Set the user to root
USER root

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install required packages and Chromium without Snap
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    ca-certificates \
    libnss3 \
    libxss1 \
    libatk-bridge2.0-0 \
    libasound2 \
    chromium-browser && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Download and install the Chrome extension (.crx file)
RUN mkdir -p /app/extensions && \
    curl -L -o /app/extensions/extension.crx "https://chrome-extension-downloader.com/agollninopbkafedoijcnbdopajjjmfa" && \
    unzip /app/extensions/extension.crx -d /app/extensions/capfizz

# Set the working directory
WORKDIR /app

# Expose the port
EXPOSE 20320

# Run Chromium in headless mode
CMD ["chromium", "--no-sandbox", "--headless"]
