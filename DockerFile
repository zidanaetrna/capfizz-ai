# Use the official Chromium Docker image
FROM zenika/alpine-chrome:latest

# Set the working directory for your app
WORKDIR /app

# Install dependencies for Capfizz extension
RUN apk update && apk add --no-cache \
    unzip \
    chromium

# Install Capfizz Extension (assuming you have a zip of the extension)
RUN mkdir -p /app/extensions && \
    curl -L -o /app/extensions/capfizz.zip https://github.com/0xmoei/capfizz-extension/archive/refs/heads/main.zip && \
    unzip /app/extensions/capfizz.zip -d /app/extensions/

# Expose port for debugging and access
EXPOSE 9222

# Command to run Chromium in headless mode with the Capfizz extension
CMD ["chromium-browser", "--headless", "--no-sandbox", "--remote-debugging-port=9222", "--load-extension=/app/extensions/capfizz-extension-main", "http://localhost"]
