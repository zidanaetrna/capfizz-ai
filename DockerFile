# Use Node.js as the base image (Puppeteer requires Node.js)
FROM node:16-slim

# Install necessary dependencies for Chromium and Puppeteer
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    unzip \
    chromium \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgdk-pixbuf2.0-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    nginx

# Install Puppeteer
WORKDIR /app
COPY package.json /app/package.json
RUN npm install

# Download Capfizz extension CRX file
RUN wget -O /app/capfizz-extension.crx https://clients2.google.com/service/update2/crx?response=redirect&prodversion=55.0&x=id%3Dagollninopbkafedoijcnbdopajjjmfa%26installsource%3Dondemand%26uc

# Set environment variables for Puppeteer to use Chromium
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Setup Nginx to serve the registration page
RUN echo '<!DOCTYPE html><html><body><h1>Capfizz Sentry Node Registration</h1><p>Please install the Capfizz extension if you haven\'t already.</p></body></html>' > /usr/share/nginx/html/index.html

# Expose port 80 for Nginx
EXPOSE 80

# Command to run Chromium in headless mode and Nginx to serve the page
CMD ["bash", "-c", "chromium --headless --disable-gpu --remote-debugging-port=9222 --load-extension=/app/capfizz-extension.crx & nginx -g 'daemon off;'"]
