FROM ubuntu:20.04

# Set the user to root
USER root

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install required packages including Snap for Chromium
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    ca-certificates \
    snapd \
    libnss3 \
    libxss1 \
    libatk-bridge2.0-0 \
    libasound2 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Chromium using Snap
RUN snap install chromium

# Set the working directory
WORKDIR /app

# Expose the port
EXPOSE 20320

# Run Chromium in headless mode
CMD ["/snap/bin/chromium", "--no-sandbox", "--headless", "--disable-gpu"]
