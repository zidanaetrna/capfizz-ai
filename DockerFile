FROM ubuntu:20.04

# Set the user to root (default user is root in Docker containers)
USER root

# Install required packages
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    gnupg2 \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    chromium \
    unzip \
    tzdata && \
    apt-get clean

# Set the working directory to /app
WORKDIR /app

# Add other necessary files like your app or configuration files
# COPY . .

# Expose the port for the web application
EXPOSE 20320

# Start the application (you can adjust this depending on what you're running)
CMD ["chromium", "--no-sandbox", "--headless", "http://localhost:20320"]
