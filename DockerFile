# Use a base image with Chromium pre-installed
FROM zenika/alpine-chrome:latest

# Set display to dummy to avoid the need for an actual display server
ENV DISPLAY=:99

# Install necessary dependencies
RUN apk update && apk add --no-cache \
    curl \
    bash \
    xvfb-run \
    ttf-freefont \
    libx11 \
    libxcomposite \
    libxrandr \
    libxi \
    libxtst \
    libxdamage \
    libgdk-pixbuf \
    && rm -rf /var/cache/apk/*

# Set the working directory
WORKDIR /app

# Expose port for web server (replace with correct port if needed)
EXPOSE 20320

# Command to run Chromium browser in headless mode
CMD ["xvfb-run", "--server-args='-screen 0 1280x1024x24'", "/usr/bin/chromium-browser", "--no-sandbox", "--headless", "--remote-debugging-port=9222"]
